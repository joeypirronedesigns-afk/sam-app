{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.samforcreators.com"
        }
      ],
      "destination": "https://samforcreators.com/$1",
      "permanent": true
    },
    {
      "source": "/landing",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/users",
      "destination": "/users.html"
    },
    {
      "source": "/meet",
      "destination": "/meet.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/persona-lab",
      "destination": "/app.html"
    },
    {
      "source": "/persona-lab/build",
      "destination": "/app.html"
    },
    {
      "source": "/api/:path((?!sam$|pdf$|stripe-webhook$|stats$|router$).*)",
      "destination": "/api/router?__path=:path"
    }
  ],
  "functions": {
    "api/pdf.js": {
      "memory": 2048,
      "maxDuration": 60
    },
    "api/sam.js": {
      "maxDuration": 300
    },
    "api/stripe-webhook.js": {
      "maxDuration": 10
    },
    "api/router.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "17 9 * * *"
    }
  ]
}
